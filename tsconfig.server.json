{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "outDir": "build",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node"
  },
  "include": ["src/server.ts"],
  "exclude": ["node_modules", ".next", "build"]
}

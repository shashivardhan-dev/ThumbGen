// tsconfig.workers.json
{
  "extends": "./tsconfig.server.json",
  "include": ["src/workers/**/*.ts"],
  "compilerOptions": {
    "outDir": "build",
    "rootDir": "src",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "module": "esnext",
    "target": "ES2020"
  }
}
